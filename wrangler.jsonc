{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "petalpatch",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/ubuntu/*"]
  }
}
